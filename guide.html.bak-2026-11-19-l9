    document.getElementById("btnSaveNote").addEventListener("click", async () => {
      stopDictation();
      const text = document.getElementById("noteTextarea").value.trim();
      const date = document.getElementById("noteDateInput").value || todayStr;
      const children = getChipSelection();

      if (!text) {
        alert("Vui lòng nhập nội dung ghi chú.");
        document.getElementById("noteTextarea").focus();
        return;
      }
      if (!modalFileNames.length) {
        alert("Mỗi ghi chú cần gắn với ít nhất 1 ảnh hoặc video.");
        return;
      }

      const saveBtn = document.getElementById("btnSaveNote");
      const oldText = saveBtn.textContent;
      saveBtn.disabled = true;
      saveBtn.textContent = "Đang lưu...";

      const prevNotesSnapshot = JSON.stringify(notes);
      const wasEditing = Boolean(editingNoteId);
      let editedIdx = -1;

      if (editingNoteId) {
        editedIdx = notes.findIndex(x => x.id === editingNoteId);
        if (editedIdx >= 0) {
          const n = notes[editedIdx];
          n.text = text;
          n.title = shortTitleFromText(text);
          n.date = date;
          n.children = children;
          n.files = [...modalFileNames];
          n.fileIds = [...modalFileIds];
          n.updatedAt = new Date().toISOString();
        }
      } else {
        notes.push({
          id: uid("n"),
          text: text,
          title: shortTitleFromText(text),
          date: date,
          children: children,
          files: [...modalFileNames],
          fileIds: [...modalFileIds],
          updatedAt: new Date().toISOString()
        });
      }

      const ok = await syncNotesToDrive(false);
      saveBtn.disabled = false;
      saveBtn.textContent = oldText;

      if (ok) {
        if (!wasEditing) selectedFileIds.clear();
        closeNoteModal();
        renderDriveGrid();
        renderNotesList();
        updateSelectionBar();
        updateBottomBar();
        if (wasEditing) {
          showToast(`Đã cập nhật Ghi chú #${editedIdx + 1}`);
        } else {
          showToast(`Đã hoàn tất Ghi chú #${notes.length}. Tiếp tục chọn ảnh hoặc bấm Send to Admin.`);
        }
      } else {
        notes = JSON.parse(prevNotesSnapshot);
        alert("Không thể lưu do lỗi kết nối mạng. Vui lòng thử lại.");
      }
    });

    // =========================================================================
    // DANH SÁCH GHI CHÚ ĐÃ HOÀN TẤT
    // =========================================================================
    function renderNotesList() {
      const divider = document.getElementById("notesDivider");
      const listEl = document.getElementById("notesList");
      const jumpBtn = document.getElementById("btnJumpNotes");

      document.getElementById("notesCount").textContent = notes.length;

      if (notes.length === 0) {
        divider.style.display = "none";
        jumpBtn.style.display = "none";
        listEl.innerHTML = "";
        return;
      }

      divider.style.display = "flex";
      jumpBtn.style.display = "inline-flex";
      jumpBtn.textContent = `Ghi chú (${notes.length}) ↓`;
      listEl.innerHTML = "";

      notes.forEach((n, idx) => {
        const card = document.createElement("div");
        card.className = "note-card";

        const metaParts = [];
        if (n.date) metaParts.push(n.date);
        const membersStr = formatMemberList(n.children);
        if (membersStr) metaParts.push(membersStr);
        metaParts.push(`${(n.files || []).length} tệp`);

        let thumbsHtml = "";
        (n.files || []).forEach((fn, fIdx) => {
          const fid = (n.fileIds && n.fileIds[fIdx]) || "";
          const fObj = findFileByIdOrName(fid, fn);
          const realId = fObj ? fObj.id : fid;
          const tUrl = realId ? getCachedThumb(realId) : null;
          if (tUrl && tUrl !== "none") {
            thumbsHtml += `<img src="${tUrl}" class="note-thumb" alt="${escapeHtml(fn)}">`;
          } else {
            thumbsHtml += `<div class="note-thumb-placeholder">${fObj && fObj.isVideo ? "VID" : "IMG"}</div>`;
          }
        });

        card.innerHTML = `
          <div class="note-card-head">
            <span class="note-num">Ghi chú #${idx + 1}</span>
            <div>
              <button type="button" class="btn-text" data-edit="${n.id}">Sửa</button>
              <button type="button" class="btn-text danger" data-del="${n.id}">Xóa</button>
            </div>
          </div>
          <div class="note-meta">${escapeHtml(metaParts.join(" · "))}</div>
          <div class="note-body"></div>
          ${thumbsHtml ? `<div class="note-thumbs">${thumbsHtml}</div>` : ""}
          <div class="note-files-caption">${escapeHtml((n.files || []).join(", "))}</div>
        `;

        card.querySelector(".note-body").textContent = n.text || "";

        card.querySelector(`[data-edit="${n.id}"]`).onclick = () => {
          openNoteModal({
            editId: n.id,
            fileIds: n.fileIds || (n.files || []).map(fn => {
              const found = findFileByIdOrName("", fn);
              return found ? found.id : "";
            }),
            fileNames: n.files || [],
            suggestedDate: n.date || todayStr
          });
        };

        card.querySelector(`[data-del="${n.id}"]`).onclick = async () => {
          if (!confirm(`Xóa Ghi chú #${idx + 1}? Ảnh và video gốc trên Google Drive sẽ không bị ảnh hưởng.`)) return;
          const prev = JSON.stringify(notes);
          notes = notes.filter(x => x.id !== n.id);
          renderDriveGrid();
          renderNotesList();
          updateBottomBar();
          const ok = await syncNotesToDrive(false);
          if (ok) {
            updateBottomBar();
            showToast(`Đã xóa Ghi chú #${idx + 1}`);
          } else {
            notes = JSON.parse(prev);
            renderDriveGrid();
            renderNotesList();
            updateBottomBar();
            alert("Không thể xóa do lỗi kết nối mạng. Vui lòng thử lại.");
          }
        };

        listEl.appendChild(card);
      });
    }

    // =========================================================================
    // ĐỒNG BỘ DRIVE & SEND TO ADMIN (KẾT THÚC ĐỢT KHI USER CHỌN)
    // =========================================================================
    function buildNotesPayload() {
      const combinedNotes = [...approvedNotes, ...notes];
      const lines = [];
      lines.push(`LEO FAMILY STORY — DANH SÁCH GHI CHÚ (${combinedNotes.length})`);
      lines.push(`========================================`);

      combinedNotes.forEach((n, idx) => {
        lines.push("");
        const membersStr = formatMemberList(n.children);
        const metaHead = membersStr ? `${n.date || todayStr} | ${membersStr}` : (n.date || todayStr);
        lines.push(`[#${idx + 1}] ${metaHead}`);
        lines.push(`Tệp đính kèm (${(n.files || []).length}): ${(n.files || []).join(", ")}`);
        lines.push(`Ghi chú: ${n.text}`);
      });

      const jsonObj = {
        version: "4.0",
        total_stories: combinedNotes.length,
        stories: combinedNotes.map((n, idx) => ({
          id: n.id,
          story_index: idx + 1,
          event_title: n.title || shortTitleFromText(n.text),
          event_date: n.date || todayStr,
          children: (n.children && n.children.length) ? n.children : ["Chung"],
          story: n.text || "",
          files: n.files || [],
          file_ids: n.fileIds || [],
          updated_at: n.updatedAt || new Date().toISOString()
        })),
        submitted_at: new Date().toISOString()
      };

      return { text: lines.join("\n"), json: jsonObj };
    }

    async function syncNotesToDrive(notifyLeo = false) {
      if (isSavingNotes) return false;
      isSavingNotes = true;
      const syncEl = document.getElementById("syncStatus");
      syncEl.textContent = notifyLeo ? "Đang gửi dữ liệu cho Admin..." : "Đang lưu nháp vào 99 Inbox/Vo...";

      const built = buildNotesPayload();
      try {
        const res = await fetch(API_URL, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({
            action: "save_notes",
            notify: Boolean(notifyLeo),
            text: built.text,
            json: built.json
          })
        });
        const data = await res.json();
        isSavingNotes = false;
        if (data && data.ok) {
          if (notifyLeo) {
            syncEl.textContent = `Đã gửi ${notes.length} ghi chú cho Admin thành công`;
          } else {
            updateBottomBar();
          }
          return true;
        }
        syncEl.textContent = "Lưu lên Drive không thành công. Vui lòng thử lại.";
        return false;
      } catch (err) {
        isSavingNotes = false;
        syncEl.textContent = "Lỗi kết nối mạng khi lưu lên Drive.";
        return false;
      }
    }

    function updateBottomBar() {
      const label = document.getElementById("btnSendLabel");
      const syncEl = document.getElementById("syncStatus");
      if (notes.length > 0) {
        label.textContent = `Send to Admin (${notes.length} ghi chú)`;
        syncEl.textContent = `Đã lưu nháp ${notes.length} ghi chú · Bấm Send to Admin khi hoàn tất`;
      } else {
        label.textContent = "Send to Admin";
        syncEl.textContent = "Các ghi chú hoàn tất sẽ tự động lưu nháp vào 99 Inbox/Vo";
      }
    }

    function closeSendConfirmModal() {
      document.getElementById("sendConfirmModal").classList.remove("show");
    }
    document.getElementById("btnSendConfirmClose").addEventListener("click", closeSendConfirmModal);
    document.getElementById("btnSendConfirmX").addEventListener("click", closeSendConfirmModal);
    document.getElementById("sendConfirmModal").addEventListener("click", (e) => {
      if (e.target.id === "sendConfirmModal") closeSendConfirmModal();
    });

    // =========================================================================
    // POP-UP NHẮC NHỞ ẢNH CHƯA GHI CHÚ & CẢNH BÁO TRƯỚC KHI XÓA (MỐC 45 NGÀY)
    // =========================================================================
    let retentionModalChecked = false;
    let currentUnnotedForModal = [];
    let currentExpiredForModal = [];

    function renderRetentionThumbStrip() {
      const strip = document.getElementById("retentionThumbStrip");
      if (!strip || !currentUnnotedForModal.length) return;
      strip.innerHTML = "";
      currentUnnotedForModal.slice(0, 12).forEach(file => {
        const ret = getFileRetentionInfo(file);
        const wrap = document.createElement("div");
        wrap.className = "picked-item";
        const thumb = getCachedThumb(file.id);
        if (thumb && thumb !== "none") {
          const img = document.createElement("img");
          img.src = thumb;
          img.alt = file.name;
          wrap.appendChild(img);
        } else {
          const fb = document.createElement("div");
          fb.className = "picked-item-fb";
          fb.textContent = file.isVideo ? "VID" : "IMG";
          wrap.appendChild(fb);
        }
        const badge = document.createElement("div");
        badge.style.cssText = "position:absolute;bottom:0;left:0;right:0;background:rgba(15,23,42,0.82);color:#fff;font-size:9.5px;font-weight:700;text-align:center;padding:2px 0;";
        badge.textContent = ret.isExpired ? "Quá hạn" : `${ret.daysLeft} ngày`;
        if (ret.isExpired) badge.style.background = "rgba(185,28,28,0.92)";
        else if (ret.isExpiringSoon) badge.style.background = "rgba(217,119,6,0.92)";
        wrap.appendChild(badge);
        strip.appendChild(wrap);
      });
    }

    function checkRetentionReminder() {
      if (retentionModalChecked) return;
      retentionModalChecked = true;

      const unnoted = driveFiles.filter(f => getNoteNumbersForFile(f).length === 0);
      if (!unnoted.length) return;

      const expired = [];
      const expiringSoon = [];
      let hasPreviousSessionFiles = false;
      const lastSubmitTs = Number(localStorage.getItem("leo_last_submit_ts") || "0");

      unnoted.forEach(f => {
        const ret = getFileRetentionInfo(f);
        if (ret.isExpired) expired.push(f);
        else if (ret.isExpiringSoon) expiringSoon.push(f);
        // Ảnh đã tải lên cách đây >= 30 phút hoặc tồn tại từ đợt trước
        if (ret.ageMs >= 30 * 60 * 1000 || lastSubmitTs > 0) {
          hasPreviousSessionFiles = true;
        }
      });

      if (!hasPreviousSessionFiles && !expired.length && !expiringSoon.length) return;

      currentUnnotedForModal = unnoted;
      currentExpiredForModal = expired;

      const titleEl = document.getElementById("retentionTitle");
      const subEl = document.getElementById("retentionSub");
      const warnBox = document.getElementById("retentionWarnBox");
      const btnFilter = document.getElementById("btnRetentionFilterTodo");
      const btnDelExp = document.getElementById("btnRetentionDeleteExpired");

      titleEl.textContent = expired.length > 0
        ? `Cảnh báo: ${expired.length} tệp đã đến hạn ${RETENTION_DAYS} ngày`
        : `Nhắc nhở: Còn ${unnoted.length} ảnh/video chưa viết ghi chú`;

      subEl.innerHTML =
        `Trong thư mục <b>99 Inbox/Vo</b> hiện có <b>${unnoted.length} tệp</b> từ lần trước chưa được gắn ghi chú.<br>` +
        `Các tệp chưa ghi chú sẽ được giữ lại trong <b>${RETENTION_DAYS} ngày</b> kể từ ngày tải lên để bạn viết tiếp.`;

      if (expired.length > 0 || expiringSoon.length > 0) {
        const parts = [];
        if (expired.length > 0) {
          parts.push(`• Có <b>${expired.length} tệp</b> đã lưu quá <b>${RETENTION_DAYS} ngày</b>. Bạn có thể chọn viết ghi chú ngay để lưu vào Album hoặc bấm xác nhận xóa khỏi 99 Inbox/Vo.`);
        }
        if (expiringSoon.length > 0) {
          const minDays = Math.min(...expiringSoon.map(f => getFileRetentionInfo(f).daysLeft));
          parts.push(`• Có <b>${expiringSoon.length} tệp</b> sắp đến hạn ${RETENTION_DAYS} ngày (còn <b>${minDays} ngày</b>).`);
        }
        warnBox.className = "notice-box show" + (expired.length > 0 ? " error" : "");
        warnBox.style.display = "block";
        warnBox.innerHTML = parts.join("<br>");
      } else {
        warnBox.style.display = "none";
      }

      btnFilter.textContent = `Xem & viết ghi chú ngay (${unnoted.length})`;
      if (expired.length > 0) {
        btnDelExp.style.display = "flex";
        btnDelExp.textContent = `Xóa ${expired.length} tệp đã quá hạn ${RETENTION_DAYS} ngày`;
      } else {
        btnDelExp.style.display = "none";
      }

      renderRetentionThumbStrip();
      document.getElementById("retentionModal").classList.add("show");
    }

    function closeRetentionModal() {
      document.getElementById("retentionModal").classList.remove("show");
    }
    document.getElementById("btnRetentionCloseX").addEventListener("click", closeRetentionModal);
    document.getElementById("btnRetentionLater").addEventListener("click", closeRetentionModal);
    document.getElementById("retentionModal").addEventListener("click", (e) => {
      if (e.target.id === "retentionModal") closeRetentionModal();
    });

    document.getElementById("btnRetentionFilterTodo").addEventListener("click", () => {
      closeRetentionModal();
      const pillTodo = document.getElementById("pillTodo");
      if (pillTodo) pillTodo.click();
      const grid = document.getElementById("photoGrid");
      if (grid) grid.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    document.getElementById("btnRetentionDeleteExpired").addEventListener("click", async () => {
      if (!currentExpiredForModal.length) return;
      const names = currentExpiredForModal.map(f => f.name).join(", ");
      if (!confirm(`Xác nhận xóa ${currentExpiredForModal.length} tệp chưa ghi chú đã quá hạn ${RETENTION_DAYS} ngày (${names}) khỏi 99 Inbox/Vo?`)) {
        return;
      }
      const btn = document.getElementById("btnRetentionDeleteExpired");
      btn.disabled = true;
      btn.textContent = "Đang xóa...";
      try {
        const ids = currentExpiredForModal.map(f => f.id);
        const res = await fetch(API_URL, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({ action: "delete_files", ids })
        });
        const data = await res.json();
        if (data && data.ok) {
          const delSet = new Set(ids);
          driveFiles = driveFiles.filter(f => !delSet.has(f.id));
          closeRetentionModal();
          renderDriveGrid();
          showToast(`Đã dọn dẹp ${ids.length} tệp quá hạn ${RETENTION_DAYS} ngày`);
        } else {
          alert("Không thể xóa tệp lúc này. Vui lòng thử lại sau.");
        }
      } catch (e) {
        alert("Lỗi kết nối mạng khi xóa tệp quá hạn.");
      } finally {
        btn.disabled = false;
      }
    });

    document.getElementById("btnSendToLeo").addEventListener("click", async () => {
      if (notes.length === 0) {
        if (selectedFileIds.size > 0) {
          document.getElementById("btnWriteNote").click();
          return;
        }
        alert("Chưa có ghi chú nào. Vui lòng chọn ít nhất 1 ảnh ở Phần 2 và hoàn tất ghi chú trước khi gửi.");
        return;
      }

      const unnotedCount = driveFiles.filter(f => getNoteNumbersForFile(f).length === 0).length;
      const confirmMsg = unnotedCount > 0
        ? `Xác nhận gửi ${notes.length} ghi chú cho Admin?\n\n(Còn ${unnotedCount} ảnh/video chưa viết ghi chú sẽ được giữ lại trong 99 Inbox/Vo trong ${RETENTION_DAYS} ngày và nhắc bạn vào lần truy cập tới).`
        : `Xác nhận gửi toàn bộ ${notes.length} ghi chú cho Admin?`;

      if (!confirm(confirmMsg)) return;

      const btn = document.getElementById("btnSendToLeo");
      btn.disabled = true;
      const built = buildNotesPayload();
      const ok = await syncNotesToDrive(true);
      btn.disabled = false;

      if (ok) {
        try {
          localStorage.setItem("leo_last_submit_ts", String(Date.now()));
          localStorage.setItem("leo_last_submitted_batch", JSON.stringify(built.json));
        } catch (e) {}
        document.getElementById("sendConfirmTitle").textContent = `Đã gửi cho Admin (${notes.length} ghi chú)`;
        document.getElementById("sendConfirmSub").textContent = unnotedCount > 0
          ? `Toàn bộ ${notes.length} ghi chú đã được lưu vào 99 Inbox/Vo và báo cho Admin. ${unnotedCount} ảnh chưa viết ghi chú vẫn được giữ lại an toàn (${RETENTION_DAYS} ngày).`
          : "Toàn bộ ghi chú đã được lưu vào thư mục 99 Inbox/Vo (mom_notes.json) và gửi thông báo cho Admin.";
        document.getElementById("sendConfirmSummary").textContent = built.text;
        document.getElementById("sendConfirmModal").classList.add("show");
      } else {
        alert("Chưa thể gửi do lỗi kết nối mạng. Toàn bộ ghi chú vẫn đang được lưu an toàn, vui lòng thử lại.");
      }
    });

    // =========================================================================
    // NHẬP GIỌNG NÓI (WEB SPEECH API — TIẾNG VIỆT)
    // =========================================================================
    const SpeechRecClass = window.SpeechRecognition || window.webkitSpeechRecognition;
    let speechRec = null;
    let isListening = false;
    let baseTextBeforeSpeech = "";
    const btnMic = document.getElementById("btnMic");
    const micStatus = document.getElementById("micStatus");

    function setMicUI(listening, msg = "", active = false) {
      isListening = listening;
      btnMic.classList.toggle("listening", listening);
      btnMic.textContent = listening ? "Đang ghi âm · Dừng" : "Nhập giọng nói";
      if (msg) {
        micStatus.textContent = msg;
        micStatus.className = "mic-status show" + (active ? " active" : "");
      } else {
        micStatus.textContent = "";
        micStatus.className = "mic-status";
      }
    }

    function stopDictation() {
      if (speechRec && isListening) {
        try { speechRec.stop(); } catch (e) {}
      }
      setMicUI(false, "");
    }

    btnMic.addEventListener("click", () => {
      if (isListening) {
        stopDictation();
        return;
      }
      if (!SpeechRecClass) {
        setMicUI(false, "Trình duyệt không hỗ trợ nhập giọng nói trực tiếp. Có thể sử dụng phím Micro trên bàn phím điện thoại.");
        return;
      }
      try {
        speechRec = new SpeechRecClass();
        speechRec.lang = "vi-VN";
        speechRec.interimResults = true;
        speechRec.continuous = true;

        const ta = document.getElementById("noteTextarea");
        const cur = ta.value;
        baseTextBeforeSpeech = cur && !/\s$/.test(cur) ? cur + " " : cur;

        speechRec.onstart = () => setMicUI(true, "Đang ghi nhận giọng nói (tiếng Việt)...", true);
        speechRec.onresult = (event) => {
          let spoken = "";
          for (let i = 0; i < event.results.length; i++) {
            spoken += event.results[i][0].transcript;
          }
          ta.value = baseTextBeforeSpeech + spoken;
        };
        speechRec.onerror = (event) => {
          if (event.error === "not-allowed" || event.error === "service-not-allowed") {
            setMicUI(false, "Chưa cấp quyền Micro cho trình duyệt. Vui lòng cấp quyền hoặc dùng phím Micro trên bàn phím.");
          } else {
            setMicUI(false, "Không nhận diện được giọng nói. Vui lòng thử lại.");
          }
        };
        speechRec.onend = () => {
          if (isListening) setMicUI(false, "Đã hoàn tất nhận diện giọng nói.");
        };
        speechRec.start();
      } catch (e) {
        setMicUI(false, "Không mở được Micro trực tiếp. Có thể sử dụng phím Micro trên bàn phím điện thoại.");
      }
    });

    // =========================================================================
    // INIT
    // =========================================================================
    window.addEventListener("DOMContentLoaded", () => {
      loadDriveFolder(false);
    });
  </script>
