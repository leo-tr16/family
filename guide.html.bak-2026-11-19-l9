    function renderDriveGrid() {
      const grid = document.getElementById("photoGrid");
      const filterRow = document.getElementById("filterRow");
      const emptyEl = document.getElementById("driveEmptyState");
      const loadingEl = document.getElementById("driveLoadingState");

      loadingEl.style.display = "none";

      if (driveFiles.length === 0) {
        filterRow.style.display = "none";
        grid.innerHTML = "";
        emptyEl.style.display = "block";
        return;
      }

      emptyEl.style.display = "none";
      filterRow.style.display = "flex";

      let doneCount = 0;
      let todoCount = 0;
      const filtered = [];

      driveFiles.forEach(file => {
        const noteNums = getNoteNumbersForFile(file);
        const hasNote = noteNums.length > 0;
        if (hasNote) doneCount++; else todoCount++;

        if (currentFilter === "all" || (currentFilter === "todo" && !hasNote) || (currentFilter === "done" && hasNote)) {
          filtered.push({ file, noteNums });
        }
      });

      document.getElementById("pillAll").textContent = `Tất cả (${driveFiles.length})`;
      document.getElementById("pillTodo").textContent = `Chưa ghi chú (${todoCount})`;
      document.getElementById("pillDone").textContent = `Đã ghi chú (${doneCount})`;

      grid.innerHTML = "";
      if (filtered.length === 0) {
        grid.innerHTML = `<div class="state-box" style="grid-column: 1 / -1;">
          ${currentFilter === "todo" ? "Toàn bộ ảnh/video hiện tại đều đã được gắn ghi chú." : "Chưa có ảnh/video nào được gắn ghi chú."}
        </div>`;
        return;
      }

      const frag = document.createDocumentFragment();
      filtered.forEach(({ file, noteNums }) => {
        const isSel = selectedFileIds.has(file.id);
        const tile = document.createElement("div");
        tile.className = "photo-tile" + (isSel ? " selected" : "") + (noteNums.length ? " noted" : "");
        tile.setAttribute("data-id", file.id);
        tile.setAttribute("role", "button");
        tile.setAttribute("aria-pressed", String(isSel));
        tile.setAttribute("aria-label", file.name);
        tile.onclick = () => toggleSelectFile(file.id);

        const cached = getCachedThumb(file.id);
        if (cached && cached !== "none") {
          const img = document.createElement("img");
          img.src = cached;
          img.alt = file.name;
          img.className = "tile-media-slot";
          tile.appendChild(img);
        } else if (cached === "none") {
          const fb = document.createElement("div");
          fb.className = "tile-fallback tile-media-slot";
          fb.innerHTML = `<div style="font-weight:700;font-size:11px;">${file.isVideo ? "VIDEO" : "IMAGE"}</div><div>${escapeHtml(file.name)}</div>`;
          tile.appendChild(fb);
        } else {
          const sk = document.createElement("div");
          sk.className = "tile-skeleton tile-media-slot";
          sk.innerHTML = `<div style="font-weight:700;margin-bottom:2px;">${file.isVideo ? "VIDEO" : "..."}</div><div>${escapeHtml(file.name.slice(0, 18))}</div>`;
          tile.appendChild(sk);
        }

        if (file.isVideo) {
          const vb = document.createElement("div");
          vb.className = "tile-vid-badge";
          vb.textContent = "Video";
          tile.appendChild(vb);
        }

        if (noteNums.length === 0) {
          const ret = getFileRetentionInfo(file);
          if (ret.isExpired) {
            const eb = document.createElement("div");
            eb.className = "tile-exp-badge expired";
            eb.textContent = "Quá 45 ngày";
            tile.appendChild(eb);
          } else if (ret.daysLeft <= 14) {
            const eb = document.createElement("div");
            eb.className = "tile-exp-badge";
            eb.textContent = `Còn ${ret.daysLeft} ngày`;
            tile.appendChild(eb);
          }
        }

        const chk = document.createElement("div");
        chk.className = "tile-check";
        chk.setAttribute("aria-hidden", "true");
        chk.textContent = "✓";
        tile.appendChild(chk);

        const zoomBtn = document.createElement("button");
        zoomBtn.type = "button";
        zoomBtn.className = "tile-zoom";
        zoomBtn.title = "Xem lớn";
        zoomBtn.setAttribute("aria-label", `Xem lớn ${file.name}`);
        zoomBtn.textContent = "🔍";
        zoomBtn.onclick = (ev) => {
          ev.stopPropagation();
          openZoomModal(file.id);
        };
        tile.appendChild(zoomBtn);

        if (noteNums.length > 0) {
          const tag = document.createElement("div");
          tag.className = "tile-note-tag";
          tag.textContent = noteNums.map(n => `#${n}`).join(", ");
          tile.appendChild(tag);
        }

        frag.appendChild(tile);
      });

      grid.appendChild(frag);
    }

