  <script>
    // =========================================================================
    // CẤU HÌNH GOOGLE DRIVE & APPS SCRIPT API
    // =========================================================================
    const DRIVE_VO_FOLDER_URL = "https://drive.google.com/drive/folders/1urN5d_pl460KQUXG-NTL-z8HPQu4JNS5";
    const API_URL = "https://script.google.com/macros/s/AKfycbxm8uwOp57EOMLceq7lwEP-gMnex5pZ6X50GXvHax_ROBGgL_mfFB-A7n0nvIPWxabXtQ/exec";
    const MAX_DIRECT_UPLOAD_BYTES = 25 * 1024 * 1024;
    const VIDEO_WARN_SEC = 30;
    const RETENTION_DAYS = 45;
    const WARN_BEFORE_DAYS = 7;
    const THUMB_BATCH_SIZE = 8;
    const THUMB_CONCURRENCY = 2;

    const MEMBER_LABELS = {
      Marc: "Marc",
      Alex: "Alex",
      Ben: "Ben",
      Tomey: "Tomey",
      Chung: "Cả nhà"
    };

    document.getElementById("btnOpenDrive").href = DRIVE_VO_FOLDER_URL;

    // Runtime state
    let driveFiles = [];          // [{ id, name, mimeType, size, isVideo, date, createdAt, updatedAt, folder }]
    let notes = [];               // [{ id, text, title, date, children, files, fileIds, updatedAt }] (active/pending)
    let approvedNotes = [];       // Ghi chú đã được Admin phê duyệt trên Cloud (giữ nguyên khi lưu, ẩn khỏi màn hình Vợ)
    let selectedFileIds = new Set();
    let currentFilter = "all";
    let thumbCache = new Map();   // fileId -> dataUri | "none"
    let pendingThumbIds = new Set();
    let thumbRetryScheduled = false;

    // Modal state
    let editingNoteId = null;
    let modalFileIds = [];
    let modalFileNames = [];
    let zoomingFileId = null;
    let openedDriveExternally = false;
    let isSavingNotes = false;

    const todayStr = new Date().toISOString().split("T")[0];

    // =========================================================================
    // UTILITIES
    // =========================================================================
    function uid(prefix = "n") {
      return prefix + "_" + Date.now().toString(36) + "_" + Math.random().toString(36).slice(2, 6);
    }

    function formatBytes(bytes) {
      if (!bytes || bytes <= 0) return "";
      if (bytes < 1024 * 1024) return Math.round(bytes / 1024) + " KB";
      return (bytes / (1024 * 1024)).toFixed(1) + " MB";
    }

    function formatMemberList(list) {
      if (!Array.isArray(list) || !list.length) return "";
      return list.map(c => MEMBER_LABELS[c] || c).join(", ");
    }

    function shortTitleFromText(text) {
      const clean = String(text || "").trim().replace(/\s+/g, " ");
      if (!clean) return "";
      const firstLine = clean.split(/[\n.!?]/)[0].trim();
      return firstLine.length > 55 ? firstLine.slice(0, 52).trim() + "..." : firstLine;
    }

    function escapeHtml(str) {
      return String(str || "").replace(/[&<>"']/g, s => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
      }[s]));
    }

    let toastTimer = null;
    function showToast(msg) {
      const el = document.getElementById("toast");
      el.textContent = msg;
      el.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove("show"), 2800);
    }

    function setUploadNotice(html, type = "") {
      const box = document.getElementById("uploadNotice");
      if (!html) {
        box.className = "notice-box";
        box.innerHTML = "";
        return;
      }
      box.className = "notice-box show" + (type ? " " + type : "");
      box.innerHTML = html;
    }

    function setDriveError(html) {
      const box = document.getElementById("driveErrorBox");
      if (!html) {
        box.className = "notice-box error";
        box.innerHTML = "";
        return;
      }
      box.className = "notice-box error show";
      box.innerHTML = html;
    }

    function getCachedThumb(fileId) {
      if (thumbCache.has(fileId)) return thumbCache.get(fileId);
      try {
        const saved = sessionStorage.getItem("leo_th_" + fileId);
        if (saved) {
          thumbCache.set(fileId, saved);
          return saved;
        }
      } catch (e) {}
      return null;
    }

    function setCachedThumb(fileId, dataUrl) {
      thumbCache.set(fileId, dataUrl || "none");
      if (dataUrl) {
        try {
          sessionStorage.setItem("leo_th_" + fileId, dataUrl);
        } catch (e) {}
      }
    }

    function findFileByIdOrName(id, name) {
      if (id) {
        const byId = driveFiles.find(f => f.id === id);
        if (byId) return byId;
      }
      if (name) {
        const low = name.toLowerCase();
        return driveFiles.find(f => f.name.toLowerCase() === low) || null;
      }
      return null;
    }

    function getNoteNumbersForFile(file) {
      const nums = [];
      notes.forEach((n, idx) => {
        const hitById = Array.isArray(n.fileIds) && n.fileIds.includes(file.id);
        const hitByName = Array.isArray(n.files) && n.files.some(fn => fn.toLowerCase() === file.name.toLowerCase());
        if (hitById || hitByName) nums.push(idx + 1);
      });
      return nums;
    }

    function getFileRetentionInfo(file) {
      const refIso = file.createdAt || file.updatedAt || "";
      const uploadedMs = refIso ? new Date(refIso).getTime() : Date.now();
      const ageMs = Math.max(0, Date.now() - (isNaN(uploadedMs) ? Date.now() : uploadedMs));
      const ageDays = Math.floor(ageMs / 86400000);
      const daysLeft = RETENTION_DAYS - ageDays;
      return {
        ageMs,
        ageDays,
        daysLeft,
        isExpired: daysLeft <= 0,
        isExpiringSoon: daysLeft > 0 && daysLeft <= WARN_BEFORE_DAYS
      };
    }

    // =========================================================================
    // PHẦN 1: UPLOAD TRỰC TIẾP LÊN GOOGLE DRIVE 99 INBOX/VO
    // =========================================================================
    const uploadInput = document.getElementById("uploadInput");
    const btnDirectUpload = document.getElementById("btnDirectUpload");

    btnDirectUpload.addEventListener("click", () => uploadInput.click());

    document.getElementById("btnOpenDrive").addEventListener("click", () => {
      openedDriveExternally = true;
    });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible" && openedDriveExternally) {
        openedDriveExternally = false;
        loadDriveFolder(true);
      }
    });

    function readFileAsBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const res = String(reader.result || "");
          const comma = res.indexOf(",");
          resolve(comma >= 0 ? res.slice(comma + 1) : res);
        };
        reader.onerror = () => reject(new Error("Không đọc được tệp"));
        reader.readAsDataURL(file);
      });
    }

    function createLocalThumbDataUrl(file) {
      return new Promise((resolve) => {
        const isVid = file.type.startsWith("video/") || /\.(mov|mp4|m4v)$/i.test(file.name);
        const objUrl = URL.createObjectURL(file);
        if (isVid) {
          const v = document.createElement("video");
          v.muted = true;
          v.playsInline = true;
          v.preload = "metadata";
          let done = false;
          const finish = (dur, thumb) => {
            if (done) return;
            done = true;
            clearTimeout(t);
            v.src = "";
            URL.revokeObjectURL(objUrl);
            resolve({ durationSec: dur || null, thumb: thumb || null });
          };
          const t = setTimeout(() => finish(v.duration || null, null), 2500);
          v.onloadedmetadata = () => {
            try { v.currentTime = Math.min(0.2, (v.duration || 1) / 2); } catch (e) { finish(v.duration, null); }
          };
          v.onseeked = () => {
            try {
              const c = document.createElement("canvas");
              c.width = 240; c.height = 240;
              const vw = v.videoWidth || 240, vh = v.videoHeight || 240;
              const side = Math.min(vw, vh);
              c.getContext("2d").drawImage(v, (vw - side) / 2, (vh - side) / 2, side, side, 0, 0, 240, 240);
              finish(v.duration, c.toDataURL("image/jpeg", 0.7));
            } catch (e) { finish(v.duration, null); }
          };
          v.onerror = () => finish(null, null);
          v.src = objUrl;
        } else {
          const img = new Image();
          img.onload = () => {
            try {
              const c = document.createElement("canvas");
              c.width = 240; c.height = 240;
              const side = Math.min(img.width, img.height);
              c.getContext("2d").drawImage(img, (img.width - side) / 2, (img.height - side) / 2, side, side, 0, 0, 240, 240);
              URL.revokeObjectURL(objUrl);
              resolve({ durationSec: null, thumb: c.toDataURL("image/jpeg", 0.7) });
            } catch (e) {
              URL.revokeObjectURL(objUrl);
              resolve({ durationSec: null, thumb: null });
            }
          };
          img.onerror = () => { URL.revokeObjectURL(objUrl); resolve({ durationSec: null, thumb: null }); };
          img.src = objUrl;
        }
      });
    }

    function normalizeUploadName(origName, index) {
      const clean = String(origName || "photo.jpg").trim();
      if (/^(image|photo)\.(jpe?g|png|heic|webp)$/i.test(clean) || /^video\.(mov|mp4)$/i.test(clean)) {
        const ext = clean.slice(clean.lastIndexOf("."));
        const d = new Date();
        const pad = n => String(n).padStart(2, "0");
        const stamp = `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}_${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;
        const prefix = /^video/i.test(clean) ? "VID" : "IMG";
        return `${prefix}_${stamp}_${pad(index + 1)}${ext}`;
      }
      return clean;
    }

    uploadInput.addEventListener("change", async (e) => {
      const files = Array.from(e.target.files || []);
      uploadInput.value = "";
      if (!files.length) return;

      setUploadNotice("");
      const oversized = [];
      const uploadable = [];

      files.forEach(f => {
        if (f.size > MAX_DIRECT_UPLOAD_BYTES) {
          oversized.push(`${f.name} (${formatBytes(f.size)})`);
        } else {
          uploadable.push(f);
        }
      });

      if (!uploadable.length && oversized.length) {
        setUploadNotice(
          `Các tệp vượt quá giới hạn 25 MB: <b>${escapeHtml(oversized.join(", "))}</b>.<br>Vui lòng dùng nút <b>Mở thư mục Google Drive</b> ở trên để tải các tệp dung lượng lớn.`,
          ""
        );
        return;
      }

      const progressBox = document.getElementById("uploadProgressBox");
      const progressLabel = document.getElementById("uploadProgressLabel");
      const progressPct = document.getElementById("uploadProgressPct");
      const progressFill = document.getElementById("uploadProgressFill");

      btnDirectUpload.disabled = true;
      progressBox.classList.add("show");

      let uploadedCount = 0;
      let duplicateCount = 0;
      let failedNames = [];
      let longVideos = [];

      for (let i = 0; i < uploadable.length; i++) {
        const file = uploadable[i];
        const uploadName = normalizeUploadName(file.name, i);
        const pctBefore = Math.round((i / uploadable.length) * 100);
        progressLabel.textContent = `Đang tải lên (${i + 1}/${uploadable.length}): ${uploadName}`;
        progressPct.textContent = `${pctBefore}%`;
        progressFill.style.width = `${Math.max(pctBefore, 6)}%`;

        try {
          const [localMeta, base64] = await Promise.all([
            createLocalThumbDataUrl(file),
            readFileAsBase64(file)
          ]);

          if (localMeta.durationSec && localMeta.durationSec > VIDEO_WARN_SEC) {
            longVideos.push(`${uploadName} (${Math.round(localMeta.durationSec)}s)`);
          }

          const res = await fetch(API_URL, {
            method: "POST",
            headers: { "Content-Type": "text/plain;charset=utf-8" },
            body: JSON.stringify({
              action: "upload",
              name: uploadName,
              mimeType: file.type || "",
              base64: base64
            })
          });

          const data = await res.json();
          if (data && data.ok && data.file) {
            if (localMeta.thumb) {
              setCachedThumb(data.file.id, localMeta.thumb);
            }
            if (data.duplicate) duplicateCount++;
            else uploadedCount++;

            if (!driveFiles.some(x => x.id === data.file.id)) {
              driveFiles.unshift(data.file);
            }
          } else {
            failedNames.push(uploadName);
          }
        } catch (err) {
          failedNames.push(uploadName);
        }

        const pctAfter = Math.round(((i + 1) / uploadable.length) * 100);
        progressPct.textContent = `${pctAfter}%`;
        progressFill.style.width = `${pctAfter}%`;
      }

      btnDirectUpload.disabled = false;
      setTimeout(() => progressBox.classList.remove("show"), 900);

      renderDriveGrid();

      const msgs = [];
      if (uploadedCount > 0) msgs.push(`Đã tải lên thành công <b>${uploadedCount} tệp</b> vào 99 Inbox/Vo.`);
      if (duplicateCount > 0) msgs.push(`${duplicateCount} tệp đã tồn tại sẵn trong thư mục.`);
      if (longVideos.length) msgs.push(`Lưu ý video dài hơn 30 giây: ${escapeHtml(longVideos.join(", "))}.`);
      if (oversized.length) msgs.push(`Tệp vượt quá 25 MB chưa thể tải trực tiếp: <b>${escapeHtml(oversized.join(", "))}</b>. Vui lòng tải qua ứng dụng Google Drive.`);
      if (failedNames.length) msgs.push(`Không thể tải lên: ${escapeHtml(failedNames.join(", "))}. Vui lòng kiểm tra kết nối mạng hoặc thử lại.`);

      const noticeType = failedNames.length ? "error" : (oversized.length || longVideos.length ? "" : "success");
      setUploadNotice(msgs.join("<br>"), noticeType);
      if (uploadedCount > 0) {
        showToast(`Đã tải lên ${uploadedCount} tệp vào 99 Inbox/Vo`);
        loadMissingThumbnails();
      }
    });

