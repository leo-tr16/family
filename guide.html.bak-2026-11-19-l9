<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Leo Family Story">
  <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
  <link rel="shortcut icon" href="favicon.ico">
  <title>Leo Family Story — Tải ảnh &amp; Ghi chú</title>
  <style>
    :root {
      --bg: #f6f5f1;
      --card: #ffffff;
      --text: #182026;
      --muted: #5c6670;
      --border: #e3e5e8;
      --primary: #1b365d;
      --primary-soft: #ebf0f6;
      --accent: #0f766e;
      --accent-dark: #0d5e58;
      --accent-soft: #e6f4f1;
      --danger: #b91c1c;
      --danger-soft: #fef2f2;
      --warn-bg: #fffbeb;
      --warn-border: #d97706;
      --warn-text: #78350f;
      --radius: 16px;
      --shadow: 0 2px 12px rgba(15, 23, 42, 0.05);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.45;
      padding: 14px 12px 176px 12px;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Top Header */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 4px 2px 14px 2px;
    }
    .topbar h1 {
      font-size: 19px;
      font-weight: 800;
      color: var(--primary);
      letter-spacing: -0.3px;
    }
    .topbar-sub {
      font-size: 12.5px;
      color: var(--muted);
      margin-top: 2px;
    }
    .btn-album-mini {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      background: #ffffff;
      color: var(--primary);
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 0 12px;
      min-height: 36px;
      font-size: 12.5px;
      font-weight: 700;
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* Section Card */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      margin-bottom: 14px;
      box-shadow: var(--shadow);
    }
    .card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }
    .card-head-actions {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .part-badge {
      display: inline-flex;
      align-items: center;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 4px 10px;
      border-radius: 6px;
    }
    .part-1 { background: var(--primary-soft); color: var(--primary); }
    .part-2 { background: var(--accent-soft); color: var(--accent-dark); }

    .card-title {
      font-size: 16px;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 5px;
    }
    .card-desc {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 12px;
    }

    /* Buttons */
    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      border: none;
      font-family: inherit;
      transition: transform 0.12s, opacity 0.18s, background-color 0.15s;
    }
    .btn:active { transform: scale(0.985); }
    .btn:disabled { opacity: 0.58; cursor: not-allowed; }

    .btn-upload-primary {
      background: var(--primary);
      color: #ffffff;
      box-shadow: 0 3px 10px rgba(27, 54, 93, 0.2);
      flex-direction: column;
      gap: 2px;
      padding: 13px 16px;
    }
    .btn-upload-primary small {
      font-size: 11.5px;
      font-weight: 500;
      opacity: 0.85;
    }

    .btn-drive-alt {
      margin-top: 9px;
      background: #f8fafc;
      color: var(--primary);
      border: 1px solid #cbd5e1;
      padding: 11px 14px;
      font-size: 13.5px;
    }

    .btn-compact {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      background: var(--primary-soft);
      color: var(--primary);
      border: 1px solid #cfd9e6;
      border-radius: 9px;
      padding: 0 11px;
      min-height: 36px;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
    }
    .btn-compact.accent {
      background: var(--accent-soft);
      color: var(--accent-dark);
      border-color: #b7ded7;
    }
    .btn-compact:active { transform: scale(0.97); }
    .btn-compact:disabled { opacity: 0.6; cursor: not-allowed; }

    .hint-line {
      font-size: 12px;
      color: var(--muted);
      margin-top: 10px;
      line-height: 1.45;
    }

    /* Upload Progress & Notices */
    .progress-box {
      display: none;
      margin-top: 12px;
      background: #f4f7fb;
      border: 1px solid #d1deed;
      border-radius: 10px;
      padding: 10px 12px;
    }
    .progress-box.show { display: block; }
    .progress-top {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 6px;
    }
    .progress-track {
      height: 7px;
      background: #dde6f0;
      border-radius: 8px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      width: 0%;
      background: var(--primary);
      transition: width 0.2s ease;
    }

    .notice-box {
      display: none;
      margin-top: 10px;
      padding: 10px 12px;
      border-radius: 10px;
      font-size: 12.5px;
      line-height: 1.45;
      background: var(--warn-bg);
      border: 1px solid #f3d08a;
      border-left: 4px solid var(--warn-border);
      color: var(--warn-text);
    }
    .notice-box.show { display: block; }
    .notice-box.error {
      background: var(--danger-soft);
      border-color: #f5c2c7;
      border-left-color: var(--danger);
      color: #991b1b;
    }
    .notice-box.success {
      background: var(--accent-soft);
      border-color: #b7ded7;
      border-left-color: var(--accent);
      color: #115e59;
    }

    /* Filter Pills */
    .filter-row {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 4px;
      margin-bottom: 10px;
      -webkit-overflow-scrolling: touch;
    }
    .filter-pill {
      white-space: nowrap;
      border: 1px solid var(--border);
      background: #f8fafc;
      color: var(--muted);
      border-radius: 18px;
      padding: 0 11px;
      min-height: 36px;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
    }
    .filter-pill.active {
      background: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
    }

    /* 3-Column Google Drive Grid */
    .photo-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }
    .photo-tile {
      position: relative;
      aspect-ratio: 1 / 1;
      background: #e9ecee;
      border-radius: 10px;
      overflow: hidden;
      cursor: pointer;
      user-select: none;
      border: 2.5px solid transparent;
      transition: transform 0.1s, border-color 0.14s;
    }
    .photo-tile.selected {
      border-color: var(--primary);
      transform: scale(0.95);
    }
    .photo-tile img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .photo-tile.noted img {
      opacity: 0.82;
    }
    .tile-skeleton {
      width: 100%;
      height: 100%;
      background: linear-gradient(110deg, #eceef0 8%, #f8f9fa 18%, #eceef0 33%);
      background-size: 200% 100%;
      animation: shimmer 1.3s linear infinite;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 6px;
      text-align: center;
      color: #6b7280;
      font-size: 10px;
      word-break: break-all;
    }
    .tile-fallback {
      width: 100%;
      height: 100%;
      background: #2b3847;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 6px;
      text-align: center;
      font-size: 10px;
      word-break: break-all;
      gap: 4px;
    }
    @keyframes shimmer {
      to { background-position-x: -200%; }
    }

    .tile-check {
      position: absolute;
      top: 5px;
      right: 5px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.9);
      border: 2px solid #94a3b8;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 900;
      color: transparent;
      z-index: 3;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.22);
    }
    .photo-tile.selected .tile-check {
      background: var(--primary);
      border-color: #ffffff;
      color: #ffffff;
    }

    .tile-zoom {
      position: absolute;
      bottom: 4px;
      left: 4px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(15, 23, 42, 0.68);
      color: #ffffff;
      border: none;
      font-size: 13.5px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 4;
      cursor: pointer;
    }
    .tile-vid-badge {
      position: absolute;
      top: 5px;
      left: 5px;
      background: rgba(15, 23, 42, 0.78);
      color: #ffffff;
      font-size: 9.5px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      z-index: 2;
    }
    .tile-exp-badge {
      position: absolute;
      top: 5px;
      left: 5px;
      background: rgba(217, 119, 6, 0.92);
      color: #ffffff;
      font-size: 9.5px;
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 4px;
      z-index: 3;
    }
    .tile-exp-badge.expired {
      background: rgba(185, 28, 28, 0.94);
    }
    .tile-note-tag {
      position: absolute;
      bottom: 5px;
      right: 5px;
      background: rgba(15, 118, 110, 0.94);
      color: #ffffff;
      font-size: 10px;
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 5px;
      z-index: 3;
      max-width: 58%;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .state-box {
      text-align: center;
      padding: 26px 16px;
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 12px;
      color: var(--muted);
      font-size: 13.5px;
      line-height: 1.5;
    }
    .spinner {
      width: 24px;
      height: 24px;
      border: 3px solid #dce4ee;
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin 0.75s linear infinite;
      margin: 0 auto 10px auto;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Completed Notes List inside Part 2 */
    .notes-divider {
      margin: 18px 0 12px 0;
      padding-top: 14px;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .notes-heading {
      font-size: 14.5px;
      font-weight: 800;
      color: var(--primary);
    }
    .notes-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .note-card {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-left: 4px solid var(--accent);
      border-radius: 12px;
      padding: 12px;
    }
    .note-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 4px;
    }
    .note-num {
      font-size: 12.5px;
      font-weight: 800;
      color: var(--accent-dark);
    }
    .note-meta {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .note-body {
      font-size: 14px;
      color: var(--text);
      white-space: pre-wrap;
      line-height: 1.5;
      margin-bottom: 9px;
    }
    .note-thumbs {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 2px;
    }
    .note-thumb {
      width: 48px;
      height: 48px;
      border-radius: 7px;
      object-fit: cover;
      border: 1px solid var(--border);
      flex-shrink: 0;
      background: #2b3847;
    }
    .note-thumb-placeholder {
      width: 48px;
      height: 48px;
      border-radius: 7px;
      background: #2b3847;
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .note-files-caption {
      font-size: 11px;
      color: var(--muted);
      margin-top: 5px;
      word-break: break-word;
    }
    .btn-text {
      background: none;
      border: none;
      color: var(--primary);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      padding: 7px 11px;
      min-height: 36px;
      font-family: inherit;
    }
    .btn-text.danger { color: var(--danger); margin-left: 4px; }

    /* Floating Selection Bar (clear separation above bottom-bar) */
    .selection-bar {
      display: none;
      position: fixed;
      bottom: calc(96px + env(safe-area-inset-bottom, 0px));
      left: 12px;
      right: 12px;
      max-width: 576px;
      margin: 0 auto;
      background: var(--primary);
      color: #ffffff;
      border-radius: 14px;
      padding: 10px 12px;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.28);
      z-index: 1050;
    }
    .selection-bar.show { display: flex; }
    .sel-info {
      font-size: 13.5px;
      font-weight: 800;
      white-space: nowrap;
    }
    .sel-actions {
      display: flex;
      gap: 6px;
      flex-shrink: 0;
    }
    .btn-sel-write {
      background: #ffffff;
      color: var(--primary);
      border: none;
      border-radius: 10px;
      padding: 9px 14px;
      font-size: 13.5px;
      font-weight: 800;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
    }
    .btn-sel-clear {
      background: rgba(255, 255, 255, 0.16);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      padding: 9px 11px;
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
    }

    /* Fixed Bottom Submit Bar */
    .bottom-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--border);
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px)) 12px;
      z-index: 1000;
    }
    .bottom-inner {
      max-width: 576px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .btn-send {
      background: var(--accent);
      color: #ffffff;
      border-radius: 12px;
      padding: 13px 18px;
      font-size: 15.5px;
      box-shadow: 0 3px 12px rgba(15, 118, 110, 0.28);
    }
    .btn-send:hover { background: var(--accent-dark); }
    .sync-status {
      font-size: 11.5px;
      text-align: center;
      color: var(--muted);
    }

    /* Modal / Bottom Sheet */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 36, 0.56);
      z-index: 2000;
      align-items: flex-end;
      justify-content: center;
      padding: 10px;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    .modal-overlay.center { align-items: center; }
    .modal-overlay.show { display: flex; }

    .modal-sheet {
      position: relative;
      background: #ffffff;
      border-radius: 20px;
      padding: 18px;
      width: 100%;
      max-width: 500px;
      max-height: 90dvh;
      overflow-y: auto;
      box-shadow: 0 14px 40px rgba(0, 0, 0, 0.25);
    }
    .modal-header-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 4px;
    }
    .modal-title {
      font-size: 17px;
      font-weight: 800;
      color: var(--primary);
    }
    .modal-close-x {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: none;
      background: #f1f5f9;
      color: var(--muted);
      font-size: 20px;
      line-height: 1;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .modal-sub {
      font-size: 12.5px;
      color: var(--muted);
      margin-bottom: 10px;
    }

    /* Selected thumbs strip inside Note Modal */
    .picked-strip {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 4px 0 10px 0;
    }
    .picked-item {
      position: relative;
      width: 60px;
      height: 60px;
      flex-shrink: 0;
      border-radius: 9px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: #2b3847;
    }
    .picked-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .picked-item-fb {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 11px;
      font-weight: 700;
    }
    .picked-remove {
      position: absolute;
      top: 2px;
      right: 2px;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: rgba(15, 23, 42, 0.78);
      color: #fff;
      border: none;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Form Controls (>= 16px to prevent iOS Safari auto-zoom) */
    .field-group { margin-bottom: 12px; }
    .field-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
      gap: 8px;
    }
    .field-label {
      font-size: 11.5px;
      font-weight: 800;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    textarea, input[type="date"] {
      width: 100%;
      padding: 10px 12px;
      font-size: 16px;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      background: #f8fafc;
      color: var(--text);
      outline: none;
      font-family: inherit;
    }
    textarea:focus, input[type="date"]:focus {
      border-color: var(--primary);
      background: #ffffff;
    }
    textarea {
      min-height: 112px;
      resize: none;
      line-height: 1.5;
    }

    /* Optional Meta Row */
    .opt-meta-grid {
      display: grid;
      grid-template-columns: 1fr 155px;
      gap: 10px;
      align-items: start;
      margin-bottom: 6px;
    }
    .chips-group {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .chip {
      padding: 6px 11px;
      border-radius: 16px;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      color: var(--muted);
      cursor: pointer;
      user-select: none;
      font-family: inherit;
    }
    .chip.active {
      background: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
    }

    /* Voice Button */
    .btn-mic {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: var(--primary-soft);
      color: var(--primary);
      border: 1px solid #cbd5e1;
      border-radius: 16px;
      padding: 6px 12px;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
    }
    .btn-mic.listening {
      background: var(--danger);
      color: #ffffff;
      border-color: var(--danger);
      animation: micPulse 1.2s infinite;
    }
    @keyframes micPulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(185, 28, 28, 0.4); }
      50% { box-shadow: 0 0 0 7px rgba(185, 28, 28, 0); }
    }
    .mic-status {
      display: none;
      font-size: 12px;
      color: var(--muted);
      margin-top: 5px;
    }
    .mic-status.show { display: block; }
