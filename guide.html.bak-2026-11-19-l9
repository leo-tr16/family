    async function loadDriveFolder(isManual = false) {
      const loadingEl = document.getElementById("driveLoadingState");
      const emptyEl = document.getElementById("driveEmptyState");
      const refreshBtn = document.getElementById("btnRefreshDrive");

      setDriveError("");
      refreshBtn.disabled = true;
      refreshBtn.textContent = "Đang tải...";

      if (driveFiles.length === 0) {
        loadingEl.style.display = "block";
        emptyEl.style.display = "none";
      }

      try {
        const res = await fetch(`${API_URL}?action=list&_t=${Date.now()}`, { method: "GET" });
        const data = await res.json();

        if (!data || !data.ok) {
          throw new Error((data && data.error) || "Phản hồi không hợp lệ");
        }

        if (!Array.isArray(data.files)) {
          loadingEl.style.display = "none";
          setDriveError(
            `<b>Cần cập nhật Google Apps Script lên phiên bản v4.0:</b><br>` +
            `Cập nhật code từ <code>00 System/scripts/mom_intake_apps_script.gs</code> và triển khai phiên bản mới.`
          );
          refreshBtn.disabled = false;
          refreshBtn.textContent = "Tải lại";
          return;
        }

        if (Array.isArray(data.notes)) {
          approvedNotes = data.notes.filter(n => n && String(n.id || "").indexOf("approved_") === 0);
          notes = data.notes.filter(n => !n || String(n.id || "").indexOf("approved_") !== 0);
        }

        // Ẩn các ảnh đã thuộc câu chuyện được Admin phê duyệt khỏi lưới chờ của Vợ
        const approvedFileIds = new Set();
        const approvedFileNames = new Set();
        approvedNotes.forEach(n => {
          (n.fileIds || []).forEach(fid => { if (fid) approvedFileIds.add(fid); });
          (n.files || []).forEach(fn => { if (fn) approvedFileNames.add(String(fn).toLowerCase()); });
        });
        driveFiles = data.files.filter(f => !approvedFileIds.has(f.id) && !approvedFileNames.has(String(f.name || "").toLowerCase()));

        const validIds = new Set(driveFiles.map(f => f.id));
        selectedFileIds.forEach(id => {
          if (!validIds.has(id)) selectedFileIds.delete(id);
        });

        loadingEl.style.display = "none";
        renderDriveGrid();
        renderNotesList();
        updateSelectionBar();
        updateBottomBar();

        if (isManual) {
          showToast(`Đã cập nhật ${driveFiles.length} tệp từ Drive`);
        } else {
          checkRetentionReminder();
        }

        await loadMissingThumbnails();
        renderRetentionThumbStrip();
      } catch (err) {
        loadingEl.style.display = "none";
        setDriveError(`Không thể kết nối tới Google Drive (${escapeHtml(err.message)}). Vui lòng kiểm tra kết nối mạng và bấm <b>Tải lại</b>.`);
      } finally {
        refreshBtn.disabled = false;
        refreshBtn.textContent = "Tải lại";
      }
    }

    async function loadMissingThumbnails(forceRetryNone = false) {
      const needIds = driveFiles
        .map(f => f.id)
        .filter(id => {
          if (pendingThumbIds.has(id)) return false;
          const cached = getCachedThumb(id);
          if (!cached) return true;
          if (forceRetryNone && cached === "none") return true;
          return false;
        });

      if (!needIds.length) return;

      const batches = [];
      for (let i = 0; i < needIds.length; i += THUMB_BATCH_SIZE) {
        batches.push(needIds.slice(i, i + THUMB_BATCH_SIZE));
      }

      needIds.forEach(id => pendingThumbIds.add(id));
      let anyNullReturned = false;

      let cursor = 0;
      async function worker() {
        while (cursor < batches.length) {
          const batch = batches[cursor++];
          try {
            const url = `${API_URL}?action=thumbs&ids=${encodeURIComponent(batch.join(","))}`;
            const res = await fetch(url, { method: "GET" });
            const data = await res.json();
            if (data && data.ok && data.thumbs) {
              batch.forEach(id => {
                const tUrl = data.thumbs[id] || null;
                if (!tUrl) anyNullReturned = true;
                setCachedThumb(id, tUrl);
                updateTileThumbDOM(id, tUrl);
              });
              renderNotesList();
            }
          } catch (e) {
            batch.forEach(id => {
              if (!getCachedThumb(id)) updateTileThumbDOM(id, null);
            });
          } finally {
            batch.forEach(id => pendingThumbIds.delete(id));
          }
        }
      }

      const workers = [];
      for (let w = 0; w < Math.min(THUMB_CONCURRENCY, batches.length); w++) {
        workers.push(worker());
      }
      await Promise.all(workers);

      if (anyNullReturned && !forceRetryNone && !thumbRetryScheduled) {
        thumbRetryScheduled = true;
        setTimeout(() => {
          thumbRetryScheduled = false;
          loadMissingThumbnails(true);
        }, 5000);
      }
    }

    function updateTileThumbDOM(fileId, dataUrl) {
      const tile = document.querySelector(`.photo-tile[data-id="${fileId}"]`);
      if (!tile) return;
      const oldMedia = tile.querySelector(".tile-media-slot");
      if (!oldMedia) return;

      const file = driveFiles.find(f => f.id === fileId);
      if (dataUrl && dataUrl !== "none") {
        const img = document.createElement("img");
        img.src = dataUrl;
        img.alt = file ? file.name : "";
        img.className = "tile-media-slot";
        oldMedia.replaceWith(img);
      } else {
        const fb = document.createElement("div");
        fb.className = "tile-fallback tile-media-slot";
        fb.innerHTML = `<div style="font-weight:700;font-size:11px;">${file && file.isVideo ? "VIDEO" : "IMAGE"}</div><div>${escapeHtml(file ? file.name : "")}</div>`;
        oldMedia.replaceWith(fb);
      }
    }

